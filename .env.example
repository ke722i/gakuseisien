APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=gakuseisien
DB_USERNAME=postgres
DB_PASSWORD=123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------
# 外部API
# ------------------------------------------------------------
# 時事ニュース機能で使用。https://gnews.io で取得したキーを設定する。
GNEWS_API_KEY=

# 店舗詳細ページのGoogleマップ表示で使用（未設定でも動作し、地図はプレースホルダー表示になる）。
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_EMBED_KEY=

# ------------------------------------------------------------
# 本番デプロイ（Render等）での上書き必須項目
#   APP_ENV=production
#   APP_DEBUG=false          # 本番でtrueは厳禁（スタックトレースが漏れる）
#   APP_KEY=                 # `php artisan key:generate --show` で生成した値
#   APP_URL=https://<本番ドメイン>
#   DB_CONNECTION / DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD
#                            # Renderのマネージドpostgresの接続情報に置き換える
# ------------------------------------------------------------
